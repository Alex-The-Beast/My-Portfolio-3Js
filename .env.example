NOTION_TOKEN=secret_your_internal_integration_token
NOTION_DATA_SOURCE_ID=your_updates_data_source_id
CONTENT_CACHE_TTL_SECONDS=300

# Optional if you prefer pasting a database id instead.
# The sync script will use the first data source in that database.
NOTION_DATABASE_ID=

# Optional property-name mapping for your Notion data source.
NOTION_TITLE_PROPERTY=Name
NOTION_CATEGORY_PROPERTY=Category
NOTION_STATUS_PROPERTY=Status
NOTION_DATE_PROPERTY=Date
NOTION_SUMMARY_PROPERTY=Summary
NOTION_FOCUS_PROPERTY=Focus
NOTION_TAGS_PROPERTY=Tags
NOTION_PUBLISHED_PROPERTY=Published
NOTION_UPDATED_AT_PROPERTY=updated
NOTION_DATE_TIME_ZONE=Asia/Kolkata
